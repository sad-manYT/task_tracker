APP_NAME=Task Tracker API
APP_ENV=development
DEBUG=false

POSTGRES_USER=task_tracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=task_tracker
# Адрес для подключения с компьютера разработчика; внутри Docker адрес задаётся в docker-compose.yml
DATABASE_URL=postgresql+psycopg://task_tracker:change_me@127.0.0.1:5433/task_tracker

# Не короче 32 символов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
